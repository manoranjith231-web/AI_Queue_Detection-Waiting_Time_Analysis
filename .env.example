# ============================================================
# QueueIQ AI — Environment Configuration
# 100% Free & Local-First Intelligent Queue Monitoring
# ============================================================

# App Environment (development | production)
ENV=development
PROJECT_NAME="QueueIQ AI"
STORE_NAME="HyperMarket Mart (Branch 104)"
SECRET_KEY="queueiq-change-this-insecure-dev-key-for-production-signing"

# Vision & Computer Vision Model Settings
YOLO_MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
CAMERA_INDEX=0
VIDEO_SOURCE=webcam
VIDEO_FILE_PATH=""
TARGET_FPS=15
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Queue Service Time & Congestion Limits
DEFAULT_SERVICE_TIME_SEC=120.0
CONGESTION_THRESHOLD_PEOPLE=4
CRITICAL_THRESHOLD_PEOPLE=6
ALERT_COOLDOWN_SECONDS=45

# Database (SQLite is local-first and zero cost)
DATABASE_PATH=backend/data/queueiq.db

# Optional Google OAuth (Only needed if enabling Google Cloud Sign-In)
# Keep blank for local-first developer session mode (no paid cloud required)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
